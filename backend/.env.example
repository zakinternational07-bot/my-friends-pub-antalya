# Скопируй этот файл в .env и поменяй значения перед запуском

PORT=3000

# Сессии админки
SESSION_SECRET=change-me-to-a-long-random-string

# Учётная запись администратора (создаётся/обновляется при старте сервера)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Провайдер оплаты: пока только "mock". Позже: "iyzico" | "paytr"
PAYMENT_PROVIDER=mock

# Провайдер писем: пока только "console" (пишет в консоль + backend/data/emails)
# Позже: "resend" | "sendgrid"
EMAIL_PROVIDER=console

# Время жизни временной брони места (минуты)
SEAT_HOLD_MINUTES=10

# Telegram-подтверждение брони на бесплатные мероприятия (см. README).
# Публичный адрес сайта — без него не собрать ссылки для бота/вебхука.
PUBLIC_BASE_URL=http://localhost:3000
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Username бота без @ (для ссылки t.me/<username>?start=...)
TELEGRAM_BOT_USERNAME=
# Необязательно: chat_id, куда слать уведомления об отменённых бронях
TELEGRAM_STAFF_CHAT_ID=
# Три ступени напоминания о неподтверждённой брони (часов до мероприятия):
REMINDER_HOURS_BEFORE=12         # первое напоминание
REMINDER_SECOND_HOURS_BEFORE=6   # повтор, если ещё не ответили
REMINDER_CANCEL_HOURS_BEFORE=3   # если всё ещё нет ответа — бронь снимается сама
